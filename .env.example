# Sauna checking
# Email and password for logging into your säkerhetsintergrering aptus account
EMAIL=<VALUE>
PASSWORD=<VALUE>
# URL for logging into to your säkerhetsintergrering aptus account
LOGIN_URL=<VALUE>
# URL for the sauna booking page
SAUNA_URL=<VALUE>
# Optional: path to a Chromium/Chrome executable to launch headless (e.g. /usr/bin/chromium).
# Leave unset to launch puppeteer's bundled Chromium in a visible (non-headless) window for local debugging.
HEADLESS_CHROMIUM_PATH=<VALUE>
# Optional: directory to store thisWeek-previousRun.json/nextWeek-previousRun.json in.
# Leave unset to store them next to the built app (dist/..).
STATE_DIR=<VALUE>
# Optional: directory to write rotating log files to.
# Leave unset to use ~/logs/bastubot.
LOG_DIR=<VALUE>

# Email sending
# Configuration for nodemailer package.
# See https://nodemailer.com for supported email services and configuration options.
EMAIL_SERVICE=<VALUE>
EMAIL_HOST=<VALUE>
EMAIL_PORT=<VALUE>
EMAIL_USER=<VALUE>
EMAIL_PASSWORD=<VALUE>