# Login for your Aptus (Säkerhetsintegrering) account
APTUS_USERNAME=<VALUE>
APTUS_PASSWORD=<VALUE>
# URL of the sauna booking calendar, the BookingCalendar page with your
# bookingGroupId. The login URL is worked out from it.
SAUNA_URL=<VALUE>

# Gmail account the alerts are sent from and to. Needs an app password, not
# the account password: https://myaccount.google.com/apppasswords
GMAIL_USER=<VALUE>
GMAIL_APP_PASSWORD=<VALUE>

# Optional: directory to keep state.json in. Leave unset to keep it in the
# repo root (next to dist/).
STATE_DIR=<VALUE>
