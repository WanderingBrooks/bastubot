    "format:check": "prettier --check src"
  },
  "dependencies": {
    "node-html-parser": "^9.0.5",
    "nodemailer": "^10.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
